# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database
DATABASE_PATH=./data/devchat.db

# JWT Configuration
JWT_SECRET=sFKgnS3dneCigNazxzd4xTYvSXx/2Orkm1dxT7n7orc=
