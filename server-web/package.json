{
  "name": "devchat-server",
  "version": "1.0.0",
  "description": "DevChat Backend Server - AI-Powered R&D Management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && cp -r src/database/*.sql dist/database/",
    "start": "node dist/server.js",
    "init-db": "node scripts/init-db.js",
    "init-default-data": "node scripts/init-default-data.js",
    "init-dev-data": "node scripts/init-dev-data.js",
    "seed-dev-users": "node scripts/seed-dev-users.js",
    "verify-dev-users": "node scripts/verify-dev-users.js",
    "migrate-local-time": "node dist/database/migrate-local-time.js",
    "migrate-message-encryption": "node dist/database/migrate-message-encryption.js",
    "rotate-message-encryption-key": "node dist/database/rotate-message-encryption-key.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "devchat",
    "project-management",
    "instant-messaging",
    "ai",
    "websocket"
  ],
  "author": "DevChat Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.6.1",
    "sql.js": "^1.10.3",
    "unzipper": "^0.12.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
